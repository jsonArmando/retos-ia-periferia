# Proveedor LLM: bedrock (recomendado en AWS) | anthropic
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=90000
RATE_LIMIT_POR_MINUTO=20
# Opcional: protege el link (el front pide la clave)
ACCESS_KEY=
# Opcional: fecha de referencia YYYY-MM-DD (por defecto, hoy en Bogotá)
FECHA_REFERENCIA=
PORT=8080
